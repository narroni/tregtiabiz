# Copy the *names* of these into your Vercel project's Settings → Environment
# Variables. Never commit real values here — this file only documents what's
# needed; it holds no secrets itself.

# Generate with: node scripts/hash-password.mjs
CMS_PASSWORD_HASH=

# A random 32+ byte secret used to sign CMS login sessions.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CMS_SESSION_SECRET=

# A GitHub Personal Access Token (fine-grained, scoped to this one repo,
# "Contents: Read and write" permission only) — used server-side to commit
# CMS edits back to the repo. Never expose this to the browser.
GITHUB_TOKEN=

# "owner/repo" — e.g. narroni/tregtiabiz
GITHUB_REPO=narroni/tregtiabiz

# Optional, defaults to "main" if unset.
GITHUB_BRANCH=main
